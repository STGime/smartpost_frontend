        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: '*Comment reply for review*\\n> ' + ($('Split comments').item.json.text || '') + '\\nDraft: ' + $json.choices[0].message.content }) }}",
        "options": {}
      },
