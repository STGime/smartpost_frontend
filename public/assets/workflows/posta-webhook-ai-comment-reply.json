        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: 'gpt-4o-mini',\n  messages: [\n    { role: 'system', content: 'You reply to social comments in a warm, concise brand voice. Max 2-3 sentences. No hashtags. If the comment is negative or sensitive, reply: ESCALATE.' },\n    { role: 'user', content: $json.text || $json.content || '' }\n  ]\n}) }}",
        "options": {}
